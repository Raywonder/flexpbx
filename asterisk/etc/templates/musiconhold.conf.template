; FlexPBX Music On Hold Configuration
; Uses local files for reliability

[general]
cachertclasses=yes
preferchannelclass=yes

; Default MOH - Local files (most reliable)
[default]
mode=files
directory=/var/lib/asterisk/moh
random=yes
sort=random

; Support queue hold music
[support]
mode=files
directory=/var/lib/asterisk/moh/support
random=yes

; Shared Callcentric DID hold music classes. These use the Flex Phone bundled
; local hold files so queues still have hold audio when an internet stream is
; unavailable.
[devine-hold]
mode=files
directory=/var/lib/asterisk/moh/flexphone-hold
random=yes
sort=random

[tappedin-hold]
mode=files
directory=/var/lib/asterisk/moh/flexphone-hold
random=yes
sort=random

[support-hold]
mode=files
directory=/var/lib/asterisk/moh/flexphone-hold
random=yes
sort=random

; Sales queue hold music  
[sales]
mode=files
directory=/var/lib/asterisk/moh/sales
random=yes

; Streaming option (if available) - requires ffmpeg
; Uncomment to use TappedIn Radio stream
;[tappedin-stream]
;mode=custom
;application=/usr/bin/ffmpeg -i https://stream.tappedin.fm/listen/tappedin_radio/radio.mp3 -f s16le -ar 8000 -ac 1 -
;format=slin

