; Callcentric Inbound/Outbound Context Template
; FlexPBX - Replace {{VARIABLE}} with actual values

;=============================================================================
; INBOUND FROM CALLCENTRIC
;=============================================================================
[from-callcentric]
exten => _X.,1,NoOp(Inbound Callcentric DID ${EXTEN} from ${CALLERID(num)})
 same => n,Set(CALLDATE=${STRFTIME(${EPOCH},,%Y%m%d-%H%M%S)})
 same => n,MixMonitor(/var/spool/asterisk/monitor/inbound/${CALLDATE}-${CALLERID(num)}-${EXTEN}.wav,b)
 same => n,Goto(flexpbx-shared-company-ivr,s,1)

exten => s,1,NoOp(Inbound Callcentric no DID from ${CALLERID(num)})
 same => n,Goto(flexpbx-shared-company-ivr,s,1)

; Shared-number company router. Use this when one Callcentric DID fronts more
; than one hosted FlexPBX brand or support group.
[flexpbx-shared-company-ivr]
exten => s,1,NoOp(Shared company IVR from ${CALLERID(num)})
 same => n,Answer()
 same => n,Set(CHANNEL(musicclass)=support-hold)
 same => n,Read(FLEXPBX_COMPANY_CHOICE,custom/flexpbx-shared-company-menu,1,,3,10)
 same => n,GotoIf($["${FLEXPBX_COMPANY_CHOICE}"="1"]?devine-creations-ivr,s,1)
 same => n,GotoIf($["${FLEXPBX_COMPANY_CHOICE}"="2"]?tappedin-ivr,s,1)
 same => n,GotoIf($["${FLEXPBX_COMPANY_CHOICE}"="3"]?flexpbx-shared-support,s,1)
 same => n,GotoIf($["${FLEXPBX_COMPANY_CHOICE}"="0"]?flexpbx-shared-support,s,1)
 same => n,GotoIf($["${FLEXPBX_COMPANY_CHOICE}"="9"]?s,1)
 same => n,Playback(custom/flexpbx-invalid-choice)
 same => n,Goto(s,1)
exten => i,1,Playback(custom/flexpbx-invalid-choice)
 same => n,Goto(s,1)
exten => t,1,Goto(flexpbx-shared-support,s,1)

[devine-creations-ivr]
exten => s,1,NoOp(Devine Creations IVR from ${CALLERID(num)})
 same => n,Answer()
 same => n,Set(CHANNEL(musicclass)=devine-hold)
 same => n,Read(DEVINE_CHOICE,custom/flexpbx-devine-menu,1,,3,10)
 same => n,GotoIf($["${DEVINE_CHOICE}"="1"]?ring,1)
 same => n,GotoIf($["${DEVINE_CHOICE}"="2"]?support,1)
 same => n,GotoIf($["${DEVINE_CHOICE}"="0"]?operator,1)
 same => n,GotoIf($["${DEVINE_CHOICE}"="9"]?flexpbx-shared-company-ivr,s,1)
 same => n,Playback(custom/flexpbx-invalid-choice)
 same => n,Goto(s,1)
exten => ring,1,NoOp(Devine Creations ring queue)
 same => n,Set(CHANNEL(musicclass)=devine-hold)
 same => n,Queue(devine-creations-ring,tTm(devine-hold),,,120)
 same => n,VoiceMail(2000@flexpbx,u)
 same => n,Hangup()
exten => support,1,NoOp(Devine Creations support queue)
 same => n,Set(CHANNEL(musicclass)=support-hold)
 same => n,Queue(support,tTm(support-hold),,,120)
 same => n,VoiceMail(2000@flexpbx,u)
 same => n,Hangup()
exten => operator,1,Goto(ring,1)
exten => i,1,Playback(custom/flexpbx-invalid-choice)
 same => n,Goto(s,1)
exten => t,1,Goto(ring,1)

[tappedin-ivr]
exten => s,1,NoOp(TappedIn IVR from ${CALLERID(num)})
 same => n,Answer()
 same => n,Set(CHANNEL(musicclass)=tappedin-hold)
 same => n,Read(TAPPEDIN_CHOICE,custom/flexpbx-tappedin-menu,1,,3,10)
 same => n,GotoIf($["${TAPPEDIN_CHOICE}"="1"]?ring,1)
 same => n,GotoIf($["${TAPPEDIN_CHOICE}"="2"]?support,1)
 same => n,GotoIf($["${TAPPEDIN_CHOICE}"="0"]?operator,1)
 same => n,GotoIf($["${TAPPEDIN_CHOICE}"="9"]?flexpbx-shared-company-ivr,s,1)
 same => n,Playback(custom/flexpbx-invalid-choice)
 same => n,Goto(s,1)
exten => ring,1,NoOp(TappedIn ring queue)
 same => n,Set(CHANNEL(musicclass)=tappedin-hold)
 same => n,Queue(tappedin-ring,tTm(tappedin-hold),,,120)
 same => n,VoiceMail(3000@flexpbx,u)
 same => n,Hangup()
exten => support,1,NoOp(TappedIn support queue)
 same => n,Set(CHANNEL(musicclass)=support-hold)
 same => n,Queue(support,tTm(support-hold),,,120)
 same => n,VoiceMail(3000@flexpbx,u)
 same => n,Hangup()
exten => operator,1,Goto(ring,1)
exten => i,1,Playback(custom/flexpbx-invalid-choice)
 same => n,Goto(s,1)
exten => t,1,Goto(ring,1)

[flexpbx-shared-support]
exten => s,1,NoOp(Shared support queue from ${CALLERID(num)})
 same => n,Answer()
 same => n,Set(CHANNEL(musicclass)=support-hold)
 same => n,Queue(support,tTm(support-hold),,,120)
 same => n,VoiceMail(2000@flexpbx,u)
 same => n,Hangup()

;=============================================================================
; OUTBOUND VIA CALLCENTRIC
;=============================================================================
[callcentric-outbound]
exten => _9XXXXXXXXXX,1,NoOp(Outbound 9 prefix via Callcentric)
 same => n,Set(CALLERID(num)={{CALLERID}})
 same => n,Set(CALLERID(name)=FlexPBX)
 same => n,Set(DIAL_NUMBER=1${EXTEN:1})
 same => n,Dial(PJSIP/${DIAL_NUMBER}@callcentric-endpoint,60,tT)
 same => n,Hangup()

exten => _91XXXXXXXXXX,1,NoOp(Outbound 91 prefix via Callcentric)
 same => n,Set(CALLERID(num)={{CALLERID}})
 same => n,Set(CALLERID(name)=FlexPBX)
 same => n,Dial(PJSIP/${EXTEN:1}@callcentric-endpoint,60,tT)
 same => n,Hangup()

exten => 911,1,NoOp(Emergency 911)
 same => n,Dial(PJSIP/911@callcentric-endpoint,60)
 same => n,Hangup()
